{
    servers {
        protocols h1 h2
    }
}

{$BODA_DOMAIN:localhost} {
    encode gzip zstd

    handle /api/* {
        reverse_proxy app:8080
    }

    handle /e/* {
        reverse_proxy app:8080
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
