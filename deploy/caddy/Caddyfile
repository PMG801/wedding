{
    servers {
        protocols h1 h2
    }
    # Clients that connect to a bare IP send no SNI, and inside Docker Caddy
    # cannot infer the public address, so name the certificate to fall back to.
    default_sni {$BODA_DOMAIN:localhost}
}

(published_file) {
    # Only existing files are cacheable, so a hidden or not-yet-published
    # file never leaves a long-lived cached 404 behind.
    @found file
    header @found Cache-Control "private, max-age=31536000, immutable"
    @heic path *.heic
    header @heic {
        Content-Type image/heic
        defer
    }
    @heif path *.heif
    header @heif {
        Content-Type image/heif
        defer
    }
    file_server
}

{$BODA_DOMAIN:localhost} {
    handle /api/* {
        encode gzip zstd
        reverse_proxy app:8080
    }

    handle /e/* {
        reverse_proxy app:8080
    }

    # Published media (ADR-0006, ADR-0011): only originals/ and derived/ are
    # mounted, read-only; hidden/ is never reachable. Every file requires a
    # valid guest session, checked by the app before Caddy serves the bytes.
    # No compression: media is already compressed and Range must stay exact.
    handle /m/* {
        forward_auth app:8080 {
            uri /api/session
        }
        header X-Content-Type-Options nosniff

        @download query dl=1
        header @download Content-Disposition attachment

        handle_path /m/o/* {
            root * /media/originals
            import published_file
        }
        handle_path /m/d/* {
            root * /media/derived
            import published_file
        }
        respond 404
    }

    # Hashed build files never change under the same name, so browsers keep
    # them for a year. Only existing files are cacheable, and a missing asset
    # is a 404 instead of the HTML shell, so an old page never caches the shell
    # under an asset name.
    handle /assets/* {
        encode gzip zstd
        root * /srv
        @found file
        header @found Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # The HTML shell is always revalidated, so a new deploy is picked up on the
    # next visit and points at the new hashed assets.
    handle {
        encode gzip zstd
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
