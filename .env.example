# Ejemplo de desarrollo: no uses estos valores secretos en producción.
# Copia este archivo a .env y sustituye los valores marcados.

# En producción, usa el dominio público para activar HTTPS automático de Caddy.
# El valor :80 mantiene HTTP local al usar Docker Compose.
BODA_DOMAIN=:80

# Para Compose local, /tmp existe dentro del contenedor pero no es persistente.
# En producción, usa la ruta del montaje persistente (por ejemplo /srv/evento).
BODA_DATA_DIR=/tmp

# Sustituye por secretos aleatorios antes de iniciar el backend.
# El token debe codificar exactamente 32 bytes con base64url.
BODA_EVENT_TOKEN=REEMPLAZAR_CON_TOKEN_BASE64URL_DE_32_BYTES
# Sustituye por un hash bcrypt o argon2id de la contraseña del administrador.
BODA_ADMIN_PASSWORD_HASH=REEMPLAZAR_CON_HASH_BCRYPT_O_ARGON2ID
# Debe contener exactamente 32 bytes.
BODA_SESSION_KEY=REEMPLAZAR_CON_32_BYTES_ALEATORIOS

# Límites y ajustes opcionales del backend (valores predeterminados de la aplicación).
BODA_MAX_PHOTO_BYTES=52428800
BODA_MAX_VIDEO_BYTES=1610612736
BODA_MAX_CONCURRENT_UPLOADS=30
BODA_UPLOAD_IDLE_TIMEOUT=90s
BODA_DISK_MIN_FREE_BYTES=16106127360
BODA_CLEANUP_INTERVAL=10m
BODA_THUMB_FALLBACK=off
BODA_LOG_LEVEL=info

# Dirección de escucha para ejecución directa; Compose la fija a :8080.
BODA_ADDR=:8080
